{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": { "CMAKE_COMPILE_WARNING_AS_ERROR": "ON" }
    },
    { "name": "release", "displayName": "Release", "inherits": "base" },
    { "name": "debug", "displayName": "Debug", "inherits": "base" }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
